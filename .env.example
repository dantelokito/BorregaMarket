# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/laborregamarket?schema=public"

# Auth (server-side). En producción: único, mínimo 32 caracteres. Sin esto la app no firma tokens.
JWT_SECRET="cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# Frontend (public)
NEXT_PUBLIC_APP_NAME="LaBorregaMarket"
NEXT_PUBLIC_APP_URL="http://localhost:8080"

# Mapa Explorar — Leaflet + teselas OpenStreetMap.
# Vacío = tile.openstreetmap.org. En producción usa un CDN que cumpla la política OSMF.
NEXT_PUBLIC_OSM_TILE_URL=""

# Email — Resend. Sin RESEND_API_KEY el envío es no-op.
RESEND_API_KEY=""
EMAIL_FROM="La Borrega Market <noreply@tudominio.com>"

# Storage — disco local (ADR-032). Default ./uploads
UPLOADS_DIR="./uploads"

# Rate limit contacto (opcionales; defaults 5 / 20)
CONTACT_RATE_LIMIT_PER_PROVIDER="5"
CONTACT_RATE_LIMIT_PER_IP="20"

# Rate limit login / registro (opcionales; defaults 10 / 15 min y 5 / hora)
AUTH_RATE_LIMIT_LOGIN_PER_IP="10"
AUTH_RATE_LIMIT_REGISTER_PER_IP="5"

# Redis — Upstash. Local sin keys: memoria. Producción: obligatorio (fail closed 503).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Inngest — jobs async en POST/GET /api/inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# WhatsApp Cloud API (opcional). Sin keys los jobs de WhatsApp no envían.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_ORDER_NEW=""
WHATSAPP_TEMPLATE_ORDER_READY=""

# Seed de cuentas demo. En producción el seed se rechaza salvo ALLOW_DEMO_SEED=true.
# ALLOW_DEMO_SEED="true"
