# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/laborregamarket?schema=public"

# Auth (server-side)
JWT_SECRET="cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# Frontend (public)
NEXT_PUBLIC_APP_NAME="LaBorregaMarket"
NEXT_PUBLIC_APP_URL="http://localhost:8080"

# Mapa Explorar — Fase 5 (ADR-020 Leaflet + OSM). Sin clave Google.
# Teselas local/QA: OSM por defecto. Prod: CDN compliant (opcional).
NEXT_PUBLIC_OSM_TILE_URL=""

# Email — Resend (Fase 2). Sin RESEND_API_KEY: no-op + AUDIT email_disabled
RESEND_API_KEY=""
EMAIL_FROM="La Borrega Market <noreply@tudominio.com>"

# Storage — Cloudinary (Fase 2 MEDIA)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Rate limit contacto (opcionales; defaults 5 / 20)
CONTACT_RATE_LIMIT_PER_PROVIDER="5"
CONTACT_RATE_LIMIT_PER_IP="20"

# Redis — Upstash (Fase 4, ADR-015). Local sin keys: in-memory + redis_disabled.
# Staging/prod: obligatorio (fail closed 503).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Inngest (Fase 4, ADR-015). Serve: POST/GET /api/inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# WhatsApp Cloud API (Fase 4 Should). Sin keys: jobs WA no-op.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_ORDER_NEW=""
WHATSAPP_TEMPLATE_ORDER_READY=""
