// LaBorregaMarket — Esquema de catálogos y módulos
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT    // Cliente: busca fruterías, contacta, hace pedidos
  PROVIDER  // Proveedor: gestiona su negocio y productos disponibles
  ADMIN     // Administrador: acceso total a catálogos, permisos y bitácora
}

enum ProductCategory {
  FRUTA
  VERDURA
  AGRICOLA
}

enum ProductUnit {
  KG
  PIEZA
  MANOJO
  CAJA
  LITRO
  GRAMO
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OrderSource {
  MARKETPLACE
  POS
}

enum PaymentMethod {
  UNPAID
  CASH
  OTHER
}

enum UnitOfMeasure {
  PZA
  KG
  GR
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ENABLE
  DISABLE
  VIEW
  CONTACT
  MEDIA_UPLOAD
}

enum SystemModule {
  USERS
  PROVIDERS
  PRODUCTS
  ORDERS
  PERMISSIONS
  AUTH
  AUDIT
}

// ─── USUARIOS ────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  phone          String?
  role           UserRole @default(CLIENT)
  isActive       Boolean  @default(true) @map("is_active")
  whatsappOptIn  Boolean  @default(false) @map("whatsapp_opt_in")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  provider  Provider?
  orders    Order[]       @relation("ClientOrders")
  reviews   Review[]      @relation("ClientReviews")
  addresses UserAddress[]
  auditLogs AuditLog[]

  @@map("users")
}

// ─── DIRECCIONES DEL CLIENTE ─────────────────────────────────────────────────

model UserAddress {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  label            String
  formattedAddress String   @map("formatted_address")
  lat              Float
  lng              Float
  isFavorite       Boolean  @default(true) @map("is_favorite")
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[] @relation("DeliveryAddress")

  @@index([userId])
  @@map("user_addresses")
}

// ─── PROVEEDORES (Fruterías / negocios) ─────────────────────────────────────

model Provider {
  id                     String   @id @default(cuid())
  userId                 String   @unique @map("user_id")
  businessName           String   @map("business_name")
  description            String?
  address                String
  city                   String   @default("Monterrey")
  state                  String   @default("Nuevo León")
  latitude               Float
  longitude              Float
  phone                  String
  logoUrl                String?  @map("logo_url")
  coverUrl               String?  @map("cover_url")
  rating                 Float    @default(0)
  reviewCount            Int      @default(0) @map("review_count")
  isActive               Boolean  @default(true) @map("is_active")
  isVerified             Boolean  @default(false) @map("is_verified")
  preparationTimeMinutes Int      @default(20) @map("preparation_time_minutes")
  offersDelivery         Boolean  @default(false) @map("offers_delivery")
  googlePlaceId          String?  @map("google_place_id")
  googleMapsUrl          String?  @map("google_maps_url")
  googleReviewsEnabled   Boolean  @default(false) @map("google_reviews_enabled")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerProducts ProviderProduct[]
  orders           Order[]
  reviews          Review[]

  @@index([city])
  @@index([businessName])
  @@index([isActive, isVerified])
  @@map("providers")
}

// ─── CATÁLOGO GLOBAL DE PRODUCTOS (solo frutas, verduras, agrícolas) ─────────

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  category    ProductCategory
  unit        ProductUnit     @default(KG)
  imageUrl    String?         @map("image_url")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  providerProducts ProviderProduct[]
  orderItems       OrderItem[]

  @@map("products")
}

// ─── PRODUCTOS POR PROVEEDOR (precio + activar/inactivar) ────────────────────

model ProviderProduct {
  id          String   @id @default(cuid())
  providerId  String   @map("provider_id")
  productId   String   @map("product_id")
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  stock       Int?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider   Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([providerId, productId])
  @@map("provider_products")
}

// ─── PEDIDOS ─────────────────────────────────────────────────────────────────

model Order {
  id                      String          @id @default(cuid())
  clientId                String?         @map("client_id")
  customerName            String?         @map("customer_name") @db.VarChar(80)
  providerId              String          @map("provider_id")
  source                  OrderSource
  status                  OrderStatus     @default(PENDING)
  paymentMethod           PaymentMethod   @default(UNPAID) @map("payment_method")
  paidAt                  DateTime?       @map("paid_at")
  total                   Decimal         @db.Decimal(10, 2) @default(0)
  notes                   String?
  idempotencyKey          String?         @map("idempotency_key")
  fulfillmentType         FulfillmentType @default(PICKUP) @map("fulfillment_type")
  deliveryAddressId       String?         @map("delivery_address_id")
  deliveryAddressSnapshot Json?           @map("delivery_address_snapshot")
  etaMinutes              Int?            @map("eta_minutes")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  client          User?        @relation("ClientOrders", fields: [clientId], references: [id], onDelete: SetNull)
  provider        Provider     @relation(fields: [providerId], references: [id])
  deliveryAddress UserAddress? @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  review          Review?

  @@unique([providerId, idempotencyKey])
  @@index([providerId, status, createdAt])
  @@index([providerId, createdAt])
  @@index([clientId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String        @id @default(cuid())
  orderId           String        @map("order_id")
  productId         String?       @map("product_id")
  providerProductId String?       @map("provider_product_id")
  itemName          String        @map("item_name") @db.VarChar(120)
  quantity          Decimal       @db.Decimal(10, 3)
  unitOfMeasure     UnitOfMeasure @default(PZA) @map("unit_of_measure")
  unitPrice         Decimal       @db.Decimal(10, 2) @map("unit_price")
  subtotal          Decimal       @db.Decimal(10, 2)

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  providerProduct ProviderProduct? @relation(fields: [providerProductId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// ─── RESEÑAS NATIVAS ─────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique @map("order_id")
  clientId   String   @map("client_id")
  providerId String   @map("provider_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  client   User     @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Restrict)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, createdAt])
  @@map("reviews")
}

// ─── MÓDULOS DEL SISTEMA (catálogo admin) ────────────────────────────────────

model Module {
  id          String       @id @default(cuid())
  code        SystemModule @unique
  name        String
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")

  permissions RolePermission[]

  @@map("modules")
}

// ─── PERMISOS POR ROL (solo visible/gestionable por ADMIN) ───────────────────

model RolePermission {
  id        String   @id @default(cuid())
  role      UserRole
  moduleId  String   @map("module_id")
  canView   Boolean  @default(false) @map("can_view")
  canCreate Boolean  @default(false) @map("can_create")
  canEdit   Boolean  @default(false) @map("can_edit")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([role, moduleId])
  @@map("role_permissions")
}

// ─── BITÁCORA / AUDITORÍA (registro por módulo) ──────────────────────────────

model AuditLog {
  id        String       @id @default(cuid())
  module    SystemModule
  action    AuditAction
  entityId  String?      @map("entity_id")
  userId    String?      @map("user_id")
  details   Json?
  ipAddress String?      @map("ip_address")
  createdAt DateTime     @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
